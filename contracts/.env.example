# /contracts secrets — NEVER copy any of these into /app or a NEXT_PUBLIC_* var.

# Deployer key (Sepolia). Funds the bankroll + pays deploy gas. Keep it here only.
PRIVATE_KEY=0x

# RPC + verification
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your-key
ETHERSCAN_API_KEY=your-etherscan-key

# Chainlink VRF V2.5 subscription (native ETH payment). Create at vrf.chain.link.
VRF_SUBSCRIPTION_ID=
