{
  "name": "@proofbet/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Single source of truth: ABI, addresses, types, and the FROZEN provably-fair math shared by /contracts and /app.",
  "exports": {
    ".": "./src/index.ts",
    "./fairness": "./src/fairness/index.ts",
    "./abi": "./src/abi/index.ts",
    "./addresses": "./src/addresses.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "gen": "npm run gen:tables && npm run gen:vectors",
    "gen:tables": "tsx scripts/generate-tables.ts",
    "gen:vectors": "tsx scripts/generate-vectors.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
